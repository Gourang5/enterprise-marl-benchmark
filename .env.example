# Enterprise MARL — LLM provider configuration
# Copy this file to .env and fill in your key for the provider you want to use.
# All three hosted providers below are FREE (no credit card needed).

# ─────────────────────────────────────────────────────────────────────────────
# OPTION 1 — Google Gemini (FREE)
# Get your key at: https://aistudio.google.com/app/apikey  (sign in with Google)
# Default model : gemini-2.0-flash
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-key-here

# ─────────────────────────────────────────────────────────────────────────────
# OPTION 2 — Alibaba Qwen via DashScope (FREE tier)
# Get your key at: https://dashscope.aliyuncs.com  (create Alibaba Cloud account)
# Default model : qwen-turbo
# ─────────────────────────────────────────────────────────────────────────────
# DASHSCOPE_API_KEY=your-dashscope-key-here

# ─────────────────────────────────────────────────────────────────────────────
# OPTION 3 — Groq Cloud (FREE tier, very fast)
# Get your key at: https://console.groq.com  (sign in with GitHub/Google)
# Default model : llama-3.1-8b-instant
# ─────────────────────────────────────────────────────────────────────────────
# GROQ_API_KEY=your-groq-key-here

# ─────────────────────────────────────────────────────────────────────────────
# OPTION 4 — Ollama (local, NO key required, but SLOW on CPU ~10 s/call)
# Install: https://ollama.com  then run: ollama pull qwen2.5:7b
# ─────────────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ─────────────────────────────────────────────────────────────────────────────
# Benchmark run settings
# ─────────────────────────────────────────────────────────────────────────────
TASK=customer_incident
EPISODES=1
MODE=centralized
